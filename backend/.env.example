PORT=5000
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Set to true when the database requires TLS (TiDB Cloud and most hosted MySQL). Leave false/unset for a local MySQL.
DB_SSL=true
JWT_SECRET=
ADMIN_BOOTSTRAP_SECRET=
# Comma-separated frontend origins allowed to call the API (no trailing slash).
# Example: http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app

# Web Push (free, browser-native). Generate once with:  npm run vapid:generate
# Keep the private key secret; never commit it or put it in the frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services: mailto:you@example.com or your https site URL
VAPID_SUBJECT=
# Optional: extra push-service hostnames to accept (comma-separated suffixes)
PUSH_ENDPOINT_ALLOWED_HOSTS=
